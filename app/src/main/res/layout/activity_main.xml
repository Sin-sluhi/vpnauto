<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="24dp" android:paddingTop="28dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textColor="@color/text"
            android:textSize="34sp" android:textStyle="bold" android:letterSpacing="-0.04"/>
        <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/teal" android:textSize="15sp" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/statusCard"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="18dp"
        android:background="@drawable/card_bg" android:orientation="horizontal"
        android:gravity="center_vertical" android:padding="16dp"
        android:clickable="true" android:focusable="true">
        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="14dp">
            <View android:id="@+id/statusRing" android:layout_width="40dp" android:layout_height="40dp"
                android:background="@drawable/glow_ring"/>
            <View android:id="@+id/statusDot" android:layout_width="12dp" android:layout_height="12dp"
                android:layout_gravity="center" android:background="@drawable/dot"/>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:id="@+id/statusTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/statusHint" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textColor="@color/text_muted" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="10dp"
        android:background="@drawable/card_bg" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/delay_title" android:textColor="@color/text" android:textSize="15sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/delay_hint" android:textColor="@color/text_muted" android:textSize="12sp"/>
        </LinearLayout>
        <TextView android:id="@+id/delayMinus" android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/stepper_bg" android:gravity="center" android:text="−"
            android:textColor="@color/text" android:textSize="18sp"/>
        <TextView android:id="@+id/delayValue" android:layout_width="44dp" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="@color/teal" android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:id="@+id/delayPlus" android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/stepper_bg" android:gravity="center" android:text="+"
            android:textColor="@color/text" android:textSize="18sp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/batteryCard" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="10dp"
        android:background="@drawable/card_bg" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="12dp"
        android:clickable="true" android:focusable="true">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/battery_title" android:textColor="@color/text" android:textSize="15sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/battery_hint" android:textColor="@color/text_muted" android:textSize="12sp"/>
        </LinearLayout>
        <TextView android:id="@+id/batteryChip" style="@style/Chip"/>
    </LinearLayout>

    <EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="46dp"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="14dp"
        android:background="@drawable/search_bg" android:paddingHorizontal="16dp"
        android:hint="@string/search_hint" android:textColorHint="@color/text_muted"
        android:textColor="@color/text" android:textSize="15sp" android:inputType="text"
        android:imeOptions="actionDone" android:maxLines="1"/>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp" android:clipToPadding="false" android:paddingBottom="24dp"/>
</LinearLayout>
