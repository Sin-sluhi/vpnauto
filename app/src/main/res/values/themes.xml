<resources>
    <style name="Theme.VpnAuto" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@drawable/window_bg</item>
        <item name="android:statusBarColor">@color/bg_top</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="colorPrimary">@color/teal</item>
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface_high</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_muted</item>
        <item name="colorOutline">@color/stroke</item>
        <item name="materialAlertDialogTheme">@style/Dialog</item>
    </style>
    <style name="Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_high</item>
        <item name="colorPrimary">@color/teal</item>
    </style>
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxWidth">150dp</item>
    </style>
</resources>
