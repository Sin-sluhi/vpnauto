<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- мягкая тень -->
    <item android:top="6dp" android:left="2dp" android:right="2dp" android:bottom="-2dp">
        <shape><solid android:color="#66000000"/><corners android:radius="22dp"/></shape>
    </item>
    <!-- светлая кромка -->
    <item android:bottom="1dp">
        <shape><solid android:color="@color/stroke_light"/><corners android:radius="22dp"/></shape>
    </item>
    <!-- тело с градиентом -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape><gradient android:angle="270" android:startColor="@color/surface_top" android:endColor="@color/surface"/>
            <corners android:radius="21dp"/></shape>
    </item>
</layer-list>
